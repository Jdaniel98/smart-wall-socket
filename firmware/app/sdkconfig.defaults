# Target and flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Board
CONFIG_SWS_BOARD_DUALR3V2=y
CONFIG_SWS_MATTER=y

# Safety: a hung control task resets the chip within 2 s, and the relays
# drop open during the reset. Idle-task checks are off so heavy Matter
# crypto during commissioning cannot trip the watchdog.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_BROWNOUT_DET=y

# Bluetooth LE for Matter commissioning, released afterwards
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Networking for Matter (from Espressif's examples)
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# Matter OTA requestor (signed updates come later)
CONFIG_ENABLE_OTA_REQUESTOR=y

# Our own console owns the UART REPL, not the CHIP shell
CONFIG_ENABLE_CHIP_SHELL=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
